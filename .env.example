# Owner-only dashboard authentication.
# Add real values in Vercel or local .env.local only. Do not commit secrets.

# Owner password login. Required in production.
DASHBOARD_OWNER_PASSWORD=

# Session signing. DASHBOARD_SESSION_SECRET is preferred.
# NEXTAUTH_SECRET and AUTH_SECRET are supported fallbacks for signing only.
DASHBOARD_SESSION_SECRET=
NEXTAUTH_SECRET=
AUTH_SECRET=

# Dashboard data source.
# sample keeps local sample fallback. live reads Google Sheets read-only when all Sheets values below are configured.
DASHBOARD_DATA_MODE=sample
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CLIENT_EMAIL=
# Use escaped newlines in deployed env vars, for example -----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
GOOGLE_SHEETS_PRIVATE_KEY=

# Backward-compatible aliases also supported by the app.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Controlled live operations. These only enable protected dry-run, approval, and audit-gated action APIs.
LIVE_OPERATIONS_ENABLED=false
GOOGLE_SHEETS_WRITE_ENABLED=false
GMAIL_READ_ENABLED=false
GOOGLE_CALENDAR_WRITE_ENABLED=false
GOOGLE_TASKS_WRITE_ENABLED=false
GOOGLE_DRIVE_WRITE_ENABLED=false

# Optional service authorizations. Keep secrets/tokens in Vercel or local .env.local only.
GMAIL_READONLY_TOKEN=
GOOGLE_CALENDAR_WRITE_TOKEN=
GOOGLE_TASKS_WRITE_TOKEN=
GOOGLE_DRIVE_WRITE_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
