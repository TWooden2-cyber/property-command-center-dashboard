# Owner-only dashboard authentication.
# Add real values in Vercel or local .env.local only. Do not commit secrets.

# NextAuth/Auth.js secret and canonical URL.
# AUTH_SECRET/AUTH_URL are supported aliases; NEXTAUTH_* is also supported.
NEXTAUTH_SECRET=
NEXTAUTH_URL=
AUTH_SECRET=
AUTH_URL=

# Google OAuth client for owner login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated approved owner Google account emails.
# Example shape only; replace outside the repo.
ALLOWED_OWNER_EMAILS=
