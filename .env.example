# Owner-only dashboard authentication.
# Add real values in Vercel or local .env.local only. Do not commit secrets.

# Owner password login. Required in production.
DASHBOARD_OWNER_PASSWORD=

# Session signing. DASHBOARD_SESSION_SECRET is preferred.
# NEXTAUTH_SECRET and AUTH_SECRET are supported fallbacks for signing only.
DASHBOARD_SESSION_SECRET=
NEXTAUTH_SECRET=
AUTH_SECRET=

# Dashboard data source.
# sample keeps local sample fallback. live reads Google Sheets read-only when all Sheets values below are configured.
DASHBOARD_DATA_MODE=sample
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CLIENT_EMAIL=
# Use escaped newlines in deployed env vars, for example -----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
GOOGLE_SHEETS_PRIVATE_KEY=
