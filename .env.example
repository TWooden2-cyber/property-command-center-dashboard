# Property Command Center production environment.
# Add real values in Vercel or local .env.local only. Do not commit secrets.

# Owner password login. Required in production.
DASHBOARD_OWNER_PASSWORD=

# Session signing. DASHBOARD_SESSION_SECRET is preferred.
# NEXTAUTH_SECRET and AUTH_SECRET are supported signing fallbacks.
DASHBOARD_SESSION_SECRET=
NEXTAUTH_SECRET=
AUTH_SECRET=
NEXTAUTH_URL=

# Production data source. Production always requires live Google Sheets.
DASHBOARD_DATA_MODE=live
GOOGLE_SHEET_ID=14nzzWCKIi0h-zHkCzW0JXmN-NQNcAWZahLpDy3CXK0c
GOOGLE_SERVICE_ACCOUNT_EMAIL=property-dashboard-reader@property-management-owner-com.iam.gserviceaccount.com
# Use escaped newlines in deployed env vars:
# -----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
GOOGLE_PRIVATE_KEY=

# Backward-compatible aliases also supported by the app.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=

# Optional public health endpoint token.
# If set, pass ?token=<token> or x-healthcheck-token.
GOOGLE_HEALTHCHECK_TOKEN=

# OAuth values are documented for future integrations only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPROVED_OWNER_EMAIL=

# Controlled live operation writes remain disabled unless separately approved.
LIVE_OPERATIONS_ENABLED=false
GOOGLE_SHEETS_WRITE_ENABLED=false
GMAIL_READ_ENABLED=false
GOOGLE_CALENDAR_WRITE_ENABLED=false
GOOGLE_TASKS_WRITE_ENABLED=false
GOOGLE_DRIVE_WRITE_ENABLED=false
